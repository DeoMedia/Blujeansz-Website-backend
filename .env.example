# Copy to .env for local development. On Railway, set these as service variables.

ENVIRONMENT=development

# Supabase -> Project Settings -> Database -> Connection string -> URI
# Use the SESSION pooler (port 5432), not the transaction pooler: asyncpg's
# prepared statements are incompatible with pgbouncer in transaction mode.
# The postgresql:// prefix is rewritten to postgresql+asyncpg:// automatically.
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Supabase -> Project Settings -> API
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_ANON_KEY=<anon-key>

# Server-side ONLY. Bypasses RLS — never expose this to the browser and never
# commit a real value. Required for media uploads.
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# Comma-separated. Add the production domain before going live.
CORS_ORIGINS=http://localhost:5173,https://blujeansz.com
